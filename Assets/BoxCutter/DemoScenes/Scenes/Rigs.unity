  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Add a Group with all the relevant boxes assigned\n2. Set the Box to
    have the following variables:\r\n    1. state = Connected\r\n    2. isDynamic
    = True\r\n    3. canWLAttach = True\n3. In the whiteListedAttach boxes, assign
    the boxes the bone connects to.\r\n4. On the rig\u2019s Root, enable canRequireBoxes
    and ensure canUseRequireAsAnchor is True. During solving, if any required boxes
    are missing, the island is treated as floating and drops.\r\n\r\nThis setup floating
    limbs by enforcing bidirectional validation.\r\n\r\nFor example, The hip requires
    both feet to in its connections chain, and similarly the feet also require the
    hip. If any bones in between are missing, the corresponding limbs will detach
    and fall.\r\n\r\nYou can also apply this technique to other complex models even
    if they are not rigs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c2f197c1fd09ef44b9e81d34868385df, type: 2}
  m_sharedMaterial: {fileID: -1822949517171684611, guid: c2f197c1fd09ef44b9e81d34868385df,
    type: 2}
